# Copy to .env and adjust. docker-compose.yml reads this file automatically.

# PostgreSQL
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me

# Backend
DB_URL=jdbc:postgresql://localhost:5432/taskflow
DB_USERNAME=taskflow
DB_PASSWORD=change-me
# At least 32 characters (256 bits) for HS256. Generate one, e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
